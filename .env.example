# =====================================================================
# Crystal Kizor - environment template
# Copy to ".env" (cp .env.example .env). Values are baked in at build time.
# On Vercel: Project Settings > Environment Variables, then redeploy.
# Only PUBLIC values here.
# =====================================================================

# Where enquiries go. REQUIRED before you deploy.
VITE_CONTACT_EMAIL=hello@example.com

# Optional: a form endpoint (Formspree, Getform, Basin...). If set, the form
# POSTs JSON there. If empty, the form opens the visitor's email app instead.
VITE_FORM_ENDPOINT=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX)
VITE_REACT_APP_GOOGLE_TRACKING=

# Public site URL (used for canonical + social tags)
VITE_FRONTEND_URL=http://localhost:3000

# Brand websites (leave empty to hide the "Visit site" link)
VITE_URL_STUDIO_COKA=
VITE_URL_ELEVATED=
VITE_URL_TEA=
VITE_URL_SPEAKING=
VITE_URL_WRITING=
VITE_URL_AKO_ALLIANCE=
VITE_URL_ALIVE_AND_FREE=

# Social links (leave empty to hide)
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_TWITTER=
